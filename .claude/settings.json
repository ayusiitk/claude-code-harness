{
  "permissions": {
    "defaultMode": "plan",
    "allow": [],
    "ask": [
      "Bash(docker:*)",
      "Bash(docker-compose:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
